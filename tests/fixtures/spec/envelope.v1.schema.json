{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vulqen.example/spec/envelope.v1.schema.json",
    "title": "Vulqen envelope v1",
    "description": "Kontrakt z vulqen-docs/plan/20-protokol-ingestu.md. Nieznany type i nieznane pole przechodzą. Zły typ znanego pola jest błędem.",
    "type": "object",
    "additionalProperties": true,
    "required": ["v", "sdk", "sent_at", "environment", "items"],
    "properties": {
        "v": { "const": 1 },
        "sdk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
            }
        },
        "sent_at": { "$ref": "#/$defs/timestamp" },
        "environment": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
        "release": { "type": "string", "minLength": 1 },
        "server_name": { "type": "string", "minLength": 1 },
        "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/$defs/item" }
        }
    },
    "$defs": {
        "timestamp": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "scalar": { "type": ["string", "number", "boolean"] },
        "attrs": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "span": {
            "type": "object",
            "additionalProperties": true,
            "required": ["span_id", "op", "started_at", "duration_ms"],
            "properties": {
                "span_id": { "$ref": "#/$defs/span_id" },
                "parent_span_id": { "$ref": "#/$defs/span_id" },
                "op": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "started_at": { "$ref": "#/$defs/timestamp" },
                "duration_ms": { "type": "number", "minimum": 0 },
                "attrs": { "$ref": "#/$defs/attrs" }
            }
        },
        "frame": {
            "type": "object",
            "additionalProperties": true,
            "required": ["file", "line", "in_app"],
            "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 0 },
                "class": { "type": "string" },
                "function": { "type": "string" },
                "in_app": { "type": "boolean" }
            }
        },
        "exception": {
            "type": "object",
            "additionalProperties": true,
            "required": ["class", "message", "frames"],
            "properties": {
                "class": { "type": "string", "minLength": 1 },
                "message": { "type": "string" },
                "frames": { "type": "array", "items": { "$ref": "#/$defs/frame" } },
                "previous": { "type": ["object", "null"] }
            }
        },
        "item": {
            "type": "object",
            "additionalProperties": true,
            "required": ["type"],
            "properties": { "type": { "type": "string" } },
            "allOf": [
                { "$ref": "#/$defs/transaction" },
                { "$ref": "#/$defs/error" },
                { "$ref": "#/$defs/stats" },
                { "$ref": "#/$defs/metric" },
                { "$ref": "#/$defs/check_in" }
            ]
        },
        "transaction": {
            "if": { "properties": { "type": { "const": "transaction" } } },
            "then": {
                "required": ["id", "trace_id", "span_id", "name", "op", "started_at", "duration_ms", "outcome"],
                "properties": {
                    "id": { "$ref": "#/$defs/uuid" },
                    "trace_id": { "$ref": "#/$defs/trace_id" },
                    "span_id": { "$ref": "#/$defs/span_id" },
                    "name": { "type": "string", "minLength": 1 },
                    "op": { "enum": ["http.server", "console.command", "queue.process"] },
                    "started_at": { "$ref": "#/$defs/timestamp" },
                    "duration_ms": { "type": "number", "minimum": 0 },
                    "outcome": { "enum": ["ok", "error", "cancelled"] },
                    "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
                    "memory_peak_bytes": { "type": "integer", "minimum": 0 },
                    "cpu_ms": { "type": "number", "minimum": 0 },
                    "spans_truncated": { "type": "boolean" },
                    "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } }
                },
                "allOf": [
                    {
                        "if": { "properties": { "op": { "const": "http.server" } } },
                        "then": { "required": ["http_status"] }
                    },
                    {
                        "if": { "properties": { "op": { "enum": ["console.command", "queue.process"] } } },
                        "then": { "not": { "required": ["http_status"] } }
                    }
                ]
            }
        },
        "error": {
            "if": { "properties": { "type": { "const": "error" } } },
            "then": {
                "required": ["id", "trace_id", "occurred_at", "exception"],
                "properties": {
                    "id": { "$ref": "#/$defs/uuid" },
                    "trace_id": { "$ref": "#/$defs/trace_id" },
                    "transaction_id": { "$ref": "#/$defs/uuid" },
                    "occurred_at": { "$ref": "#/$defs/timestamp" },
                    "exception": { "$ref": "#/$defs/exception" }
                }
            }
        },
        "stats": {
            "if": { "properties": { "type": { "const": "stats" } } },
            "then": {
                "required": ["period_start", "period_end", "transactions"],
                "properties": {
                    "period_start": { "$ref": "#/$defs/timestamp" },
                    "period_end": { "$ref": "#/$defs/timestamp" },
                    "transactions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": true,
                            "required": ["name", "op", "outcome", "count", "duration_ms_sum", "buckets"],
                            "properties": {
                                "name": { "type": "string", "minLength": 1 },
                                "op": { "enum": ["http.server", "console.command", "queue.process"] },
                                "outcome": { "enum": ["ok", "error", "cancelled"] },
                                "count": { "type": "integer", "minimum": 0 },
                                "duration_ms_sum": { "type": "number", "minimum": 0 },
                                "buckets": {
                                    "type": "array",
                                    "minItems": 10,
                                    "maxItems": 10,
                                    "items": { "type": "integer", "minimum": 0 }
                                }
                            }
                        }
                    }
                }
            }
        },
        "metric": {
            "if": { "properties": { "type": { "const": "metric" } } },
            "then": {
                "required": ["name", "kind", "value", "at"],
                "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "kind": { "enum": ["gauge", "counter"] },
                    "value": { "type": "number" },
                    "at": { "$ref": "#/$defs/timestamp" },
                    "attrs": { "$ref": "#/$defs/attrs" }
                }
            }
        },
        "check_in": {
            "if": { "properties": { "type": { "const": "check_in" } } },
            "then": {
                "required": ["monitor", "status", "at"],
                "properties": {
                    "monitor": { "type": "string", "minLength": 1 },
                    "status": { "enum": ["ok", "error", "in_progress"] },
                    "duration_ms": { "type": "number", "minimum": 0 },
                    "at": { "$ref": "#/$defs/timestamp" }
                }
            }
        }
    }
}
